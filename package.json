{
  "name": "pi-provider-service-tier",
  "version": "0.1.7-fork.4",
  "description": "Provider/model-scoped service_tier management extension for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "service-tier",
    "fast"
  ],
  "files": [
    "src/index.ts",
    "src/session-state.ts",
    "src/service-tiers.ts",
    "src/support-map.ts",
    "src/probe-evidence.ts",
    "src/legacy-presets.ts",
    "src/auth-scope.ts",
    "src/extension-ui.ts",
    "src/tier-picker.ts",
    "src/status-format.ts",
    "src/support-storage.ts",
    "scripts/*.mjs",
    "docs/*.md",
    "docs/maintenance/*.md",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "docs/releasing.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "bench:service-tier": "node scripts/benchmark-service-tier.mjs --model openai/gpt-6.1-sol",
    "bench:service-tier:quick": "PST_BENCH_ROUNDS=1 PST_BENCH_WARMUPS=0 node scripts/benchmark-service-tier.mjs --model openai/gpt-6.1-sol",
    "bench:service-tier:stress": "PST_BENCH_ROUNDS=5 PST_BENCH_WARMUPS=1 PST_BENCH_THINKING=high node scripts/benchmark-service-tier.mjs --model openai/gpt-6.1-sol",
    "bench:service-tier:stress:light": "PST_BENCH_ROUNDS=2 PST_BENCH_WARMUPS=0 PST_BENCH_THINKING=medium PST_BENCH_WORKLOAD=light node scripts/benchmark-service-tier.mjs --model openai/gpt-6.1-sol",
    "bench:service-tier:swap": "PST_BENCH_START_WITH=tier node scripts/benchmark-service-tier.mjs --model openai/gpt-6.1-sol",
    "check": "npm run typecheck && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhaoxiang/pi-provider-service-tier.git"
  },
  "bugs": {
    "url": "https://github.com/chenhaoxiang/pi-provider-service-tier/issues"
  },
  "homepage": "https://github.com/chenhaoxiang/pi-provider-service-tier#readme",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "author": {
    "name": "luxmargos",
    "email": "owlflyx12@gmail.com"
  }
}
